NODE_ENV=development
PORT=3400
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trimtrack_db
DB_USER=trimtrack
DB_PASSWORD=replace-with-a-local-password

# Used only by pnpm db:seed:admin. Keep real values in backend/.env.
ADMIN_FULL_NAME=TrimTrack Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-password

# Use a random value of at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-session-secret
